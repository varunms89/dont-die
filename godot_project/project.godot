; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be edited by text.

config_version=5

[application]

config/name="Die Again: Troll Game Ever"
config/description="A hilarious, fast-paced 2D troll puzzle platformer inspired by Level Devil"
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
boot_splash/bg_color=Color(0.05, 0.03, 0.1, 1)
config/icon="res://assets/icon.png"

[autoload]

AudioManager="*res://scripts/audio_manager.gd"

[display]

window/size/viewport_width=800
window/size/viewport_height=450
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=6

